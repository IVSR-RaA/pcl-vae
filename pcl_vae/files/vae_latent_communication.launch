<!-- vae_latent_communication.launch
     Bring up the VAE encoder and decoder nodes.

     Usage
     
     roslaunch pcl_vae vae_latent_communication.launch robot_type:=ground

     Arguments

     robot_type          : aerial | ground  (default: ground)
     config_path         : absolute path to vae_validation_config.yaml
     publish_occ_map     : true | false  (enable occupancy-map output, default: false)
     publish_norm_image  : true | false  (enable normalised image output, default: false)
     queue_size          : subscriber/publisher queue depth (default: 1)
-->
<launch>
  <!-- ================================================================ -->
  <!--  Arguments                                                        -->
  <!-- ================================================================ -->
  <arg name="robot_type"         default="ground" />
  <arg name="config_path"
       default="$(find pcl_vae)/inference/config/$(arg robot_type)/vae_validation_config.yaml" />
  <arg name="publish_occ_map"    default="false" />
  <arg name="publish_norm_image" default="false" />
  <arg name="queue_size"         default="1" />

  <!-- ================================================================ -->
  <!--  Encoder node                                                     -->
  <!--   Subscribes : /vae_encoder/input/range_image                    -->
  <!--   Publishes  : /vae_encoder/output/latent_vector                 -->
  <!-- ================================================================ -->
  <node
    name  = "vae_encoder"
    pkg   = "pcl_vae"
    type  = "vae_encoder_node.py"
    output= "screen"
    respawn="false">

    <param name="config_path"  value="$(arg config_path)" />
    <param name="robot_type"   value="$(arg robot_type)" />
    <param name="queue_size"   value="$(arg queue_size)" />
  </node>

  <!-- ================================================================ -->
  <!--  Decoder node                                                     -->
  <!--   Subscribes : /vae_decoder/input/latent_vector                  -->
  <!--   Publishes  : /vae_decoder/output/range_image                   -->
  <!--               /vae_decoder/output/range_image_norm  (optional)   -->
  <!--               /vae_decoder/output/occupancy_map     (optional)   -->
  <!-- ================================================================ -->
  <node
    name  = "vae_decoder"
    pkg   = "pcl_vae"
    type  = "vae_decoder_node.py"
    output= "screen"
    respawn="false">

    <param name="config_path"              value="$(arg config_path)" />
    <param name="robot_type"               value="$(arg robot_type)" />
    <param name="publish_occupancy_map"    value="$(arg publish_occ_map)" />
    <param name="publish_normalised_image" value="$(arg publish_norm_image)" />
    <param name="queue_size"               value="$(arg queue_size)" />
  </node>

  <!-- ================================================================ -->
  <!--  Wire encoder output → decoder input                             -->
  <!-- ================================================================ -->
  <remap
    from="/vae_decoder/input/latent_vector"
    to  ="/vae_encoder/output/latent_vector" />

</launch>
