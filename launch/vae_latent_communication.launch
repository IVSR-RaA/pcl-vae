<!-- vae_latent_communication.launch
     Bring up the VAE encoder and decoder nodes. -->
<launch>
  <arg name="robot_type" default="ground" />
  <arg
    name="config_path"
    default="$(find pcl_vae)/pcl_vae/inference/config/$(arg robot_type)/vae_validation_config.yaml" />
  <arg name="publish_occ_map" default="false" />
  <arg name="publish_norm_image" default="false" />
  <arg name="queue_size" default="1" />

  <node
    name="vae_encoder"
    pkg="pcl_vae"
    type="vae_encoder_node.py"
    output="screen"
    respawn="false">
    <param name="config_path" value="$(arg config_path)" />
    <param name="robot_type" value="$(arg robot_type)" />
    <param name="queue_size" value="$(arg queue_size)" />
  </node>

  <node
    name="vae_decoder"
    pkg="pcl_vae"
    type="vae_decoder_node.py"
    output="screen"
    respawn="false">
    <param name="config_path" value="$(arg config_path)" />
    <param name="robot_type" value="$(arg robot_type)" />
    <param name="publish_occupancy_map" value="$(arg publish_occ_map)" />
    <param name="publish_normalised_image" value="$(arg publish_norm_image)" />
    <param name="queue_size" value="$(arg queue_size)" />
    <remap
      from="~input/latent_vector_stamped"
      to="/vae_encoder/output/latent_vector_stamped" />
  </node>
</launch>
